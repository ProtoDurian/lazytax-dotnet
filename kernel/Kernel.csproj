<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The app. It finds every context by pattern and wires it; nobody edits a list here. -->
  <PropertyGroup>
    <RootNamespace>LazyTax.Kernel</RootNamespace>
    <AssemblyName>LazyTax.Kernel</AssemblyName>
    <UserSecretsId>lazytax-model-kernel</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../platform/Platform.csproj" />
    <ProjectReference Include="../contexts/*/src/*.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../dependency.yaml" Link="dependency.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Registration generated inside the build (A372: nothing generated is committed). For every
    contexts/<name>/src project referenced above, emit `new global::Ctx.<Name>.<Name>Context()` into
    obj/, then compile it. No reflection scan at runtime. A context with a contract but no src/Context.cs
    yet becomes a PendingContext: its contracts resolve to placeholders that throw, so others can boot.
  -->
  <Target Name="GenerateContextRegistry" BeforeTargets="CoreCompile" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <_LtCtx Include="@(ProjectReference)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', 'contexts[/\\][a-z][a-z0-9]*[/\\]src[/\\]'))">
        <CtxName>$([System.Text.RegularExpressions.Regex]::Replace('%(Identity)', '^.*contexts[/\\]([a-z][a-z0-9]*)[/\\]src[/\\].*$', '$1'))</CtxName>
      </_LtCtx>
      <_LtPending Include="@(_LtCtx)" Condition="!Exists('$(MSBuildProjectDirectory)/../contexts/%(_LtCtx.CtxName)/src/Context.cs')" />
      <_LtCtx Remove="@(_LtPending)" />
      <_LtCtx Update="@(_LtCtx)">
        <CtxPascal>$([System.String]::Copy('%(CtxName)').Substring(0, 1).ToUpperInvariant())$([System.String]::Copy('%(CtxName)').Substring(1))</CtxPascal>
      </_LtCtx>
      <_LtLine Include="    new global::Ctx.%(_LtCtx.CtxPascal).%(_LtCtx.CtxPascal)Context()," />
      <_LtLine Include="@(_LtPending->'    new global::LazyTax.Kernel.Boot.PendingContext(&quot;%(CtxName)&quot;),')" />
    </ItemGroup>
    <PropertyGroup>
      <_LtRegistry>$(IntermediateOutputPath)ContextRegistry.g.cs</_LtRegistry>
    </PropertyGroup>
    <WriteLinesToFile File="$(_LtRegistry)" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="// generated by Kernel.csproj (GenerateContextRegistry), not committed;namespace LazyTax.Kernel%3B;public static class ContextRegistry;{;  public static global::LazyTax.Platform.Context.IContext[] All() => [;@(_LtLine);  ]%3B;}" />
    <ItemGroup>
      <Compile Include="$(_LtRegistry)" />
      <FileWrites Include="$(_LtRegistry)" />
    </ItemGroup>
  </Target>

</Project>
