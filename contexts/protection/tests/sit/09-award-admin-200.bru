meta {
  name: award-weekly as admin awards nothing for an empty week
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/Protection/award-weekly
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {"userId": "{{subA}}"}
}

assert {
  res.status: eq 200
  res.body.awards: eq 0
}
