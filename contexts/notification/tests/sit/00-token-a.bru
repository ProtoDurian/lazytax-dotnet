meta {
  name: mint a fresh user A (inbox assertions need an empty inbox; other collections share sit-user-a)
  type: http
  seq: 0
}

post {
  url: {{logtoUrl}}/token
  body: json
  auth: none
}

script:pre-request {
  bru.setVar("subA", "sit-notification-a-" + Date.now());
}

body:json {
  { "sub": "{{subA}}", "scope": "" }
}

script:post-response {
  bru.setVar("tokenA", res.body.access_token);
}

assert {
  res.status: eq 200
}
