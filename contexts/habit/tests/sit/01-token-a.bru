meta {
  name: 01-token-a
  type: http
  seq: 1
}

post {
  url: {{logtoUrl}}/token
  body: json
  auth: none
}

body:json {
  { "sub": "sit-habit-a", "scope": "" }
}

script:post-response {
  bru.setVar("userA", "sit-habit-a");
  bru.setVar("tokenA", res.body.access_token);
}

assert {
  res.status: eq 200
}
