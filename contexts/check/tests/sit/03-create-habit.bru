meta {
  name: A creates a habit (habit context) to check against
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/Habit/{{subA}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenA}}
}

body:json {
  {
    "task": "SIT check habit",
    "daysOfWeek": ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
    "notificationTime": "08:00:00",
    "stake": "0",
    "timezone": "UTC",
    "deadlineTime": "23:59:00"
  }
}

script:post-response {
  bru.setVar("checkVersionA", res.body.id);
}

assert {
  res.status: eq 200
}
